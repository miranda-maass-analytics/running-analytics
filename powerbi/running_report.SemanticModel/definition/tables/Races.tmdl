		sourceColumn: was_pr_at_time

		annotation SummarizationSetBy = Automatic

	column is_current_pr
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: d2d762a2-25c5-4c8e-89b8-2428821b50a6
		summarizeBy: none
		sourceColumn: is_current_pr

		annotation SummarizationSetBy = Automatic

	column strava_activity_id
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: dddce6db-3491-4bde-a040-09550c5181cd
		summarizeBy: none
		sourceColumn: strava_activity_id

		annotation SummarizationSetBy = User

	column strava_distance_km
		dataType: double
		formatString: 0.00
		lineageTag: 196139af-232c-4a5e-840c-fd077da81f7b
		summarizeBy: none
		sourceColumn: strava_distance_km

		annotation SummarizationSetBy = User

	/// Pace as m:ss text (blank for triathlons)
	column 'Pace /km' =
			VAR p = Races[pace_min_per_km]
			VAR t = ROUND(p * 60, 0)
			RETURN
			    IF(ISBLANK(p), BLANK(), INT(t / 60) & ":" & FORMAT(MOD(t, 60), "00"))
		dataType: string
		lineageTag: aefd4724-617b-46f5-bcc1-6cc4b39b109a
		summarizeBy: none

	column PR = IF(Races[is_current_pr], "PR", BLANK())
		dataType: string
		lineageTag: 2be8d523-324b-4980-8b2f-01ac04c90596
		summarizeBy: none

	column city
		dataType: string
		lineageTag: 6f243453-1482-438e-8235-089d561611a4
		dataCategory: Place
		summarizeBy: none
		sourceColumn: city

		annotation SummarizationSetBy = Automatic

