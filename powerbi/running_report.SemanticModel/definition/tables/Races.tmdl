	column finish_time
		dataType: string
		lineageTag: bbcc5c28-d1f3-4b8a-8bfe-2d9b254a5c83
		summarizeBy: none
		sourceColumn: finish_time

		annotation SummarizationSetBy = Automatic

	column pace_min_per_km
		dataType: double
		formatString: 0.00
		lineageTag: a3949db7-fa2a-4d35-8f4c-c2fc30900ce6
		summarizeBy: none
		sourceColumn: pace_min_per_km

		annotation SummarizationSetBy = User

	column pace_min_per_mi
		dataType: double
