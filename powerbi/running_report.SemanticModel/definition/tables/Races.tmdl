		sourceColumn: pace_min_per_mi

		annotation SummarizationSetBy = User

	column was_pr_at_time
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: b113a2bd-5684-45fd-a6f9-840bccdfc92d
