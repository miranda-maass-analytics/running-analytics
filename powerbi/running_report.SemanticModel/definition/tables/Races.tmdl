table Races
	lineageTag: 39ffc812-02b1-4e5c-b682-daccbddf304a

	measure 'Races Run' = COUNTROWS(Races)
		formatString: #,0
		displayFolder: KPIs
		lineageTag: 87329fce-dc25-4b93-b3f3-8cdd3d315aaf

	measure 'Best Time (s)' = MIN(Races[finish_time_s])
		formatString: 0
		isHidden
		displayFolder: PRs
		lineageTag: 077113c1-34c6-40a2-88b0-2d01d92ee23d

	/// Fastest finish in the current filter context, as h:mm:ss
	measure 'Best Time' =
			VAR s = [Best Time (s)]
			VAR h = INT(s / 3600)
			VAR m = INT(MOD(s, 3600) / 60)
			VAR sec = MOD(s, 60)
			RETURN
			    IF(
			        ISBLANK(s), BLANK(),
			        IF(h > 0, h & ":" & FORMAT(m, "00") & ":" & FORMAT(sec, "00"), m & ":" & FORMAT(sec, "00"))
			    )
		displayFolder: PRs
		lineageTag: 4dbeb102-d099-45f6-8f1c-74dbb1ab05e1

	measure '5K PR' = CALCULATE([Best Time], Races[distance] = "5K")
		displayFolder: PRs
		lineageTag: 3ed2ffaa-b9a1-40af-a524-edc5b3b11627

	measure '10K PR' = CALCULATE([Best Time], Races[distance] = "10K")
		displayFolder: PRs
		lineageTag: a7a2a0a6-941e-45c0-9d21-bae663052137

	measure 'Half Marathon PR' = CALCULATE([Best Time], Races[distance] = "Half Marathon")
		displayFolder: PRs
		lineageTag: 69fc3531-11c6-4da0-88d8-0a6f9ee6db95

	measure 'Marathon PR' = CALCULATE([Best Time], Races[distance] = "Marathon")
		displayFolder: PRs
		lineageTag: 4d034d18-b5f0-4861-aa32-816f32e35d95

	measure 'Olympic Tri PR' = CALCULATE([Best Time], Races[distance] = "Olympic Triathlon")
		displayFolder: PRs
		lineageTag: c313f730-d0d9-41a4-821d-328005b4ca47

	measure '10K Time (min)' = CALCULATE(SUM(Races[finish_time_min]), Races[distance] = "10K")
		formatString: 0.0
		displayFolder: Charts
		lineageTag: 6ca4bfb5-6add-4f73-9477-da93cf27313e

	measure 'Half Marathon Time (min)' = CALCULATE(SUM(Races[finish_time_min]), Races[distance] = "Half Marathon")
		formatString: 0.0
		displayFolder: Charts
		lineageTag: b0e19ef5-0c91-4231-8515-4c993eec27b8

	/// Per-race pace as m:ss in the selected unit (blank for triathlons)
	measure 'Race Pace' =
			VAR p = IF([Selected Unit] = "mi", MAX(Races[pace_min_per_mi]), MAX(Races[pace_min_per_km]))
			VAR t = ROUND(p * 60, 0)
			RETURN
			    IF(ISBLANK(p), BLANK(), INT(t / 60) & ":" & FORMAT(MOD(t, 60), "00") & " /" & [Selected Unit])
		displayFolder: Charts
		lineageTag: 2e4c0f8e-8659-491f-b58c-ecb18231b085

	measure 'Map Latitude' = AVERAGE(Races[latitude])
		displayFolder: Map
		lineageTag: 3571fe64-9974-4969-85c1-8f813f603862

	measure 'Map Longitude' = AVERAGE(Races[longitude])
		displayFolder: Map
		lineageTag: c4353dbc-ccc1-4a86-9295-10fa33fd8217

	column race_date
		dataType: dateTime
		formatString: mmm d, yyyy
		lineageTag: 6d3b61e2-98ab-489e-88d2-82dbe2500032
		summarizeBy: none
		sourceColumn: race_date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column event_name
		dataType: string
		lineageTag: 1a107c11-6aed-42f4-966e-234311e1bb05
		summarizeBy: none
		sourceColumn: event_name

		annotation SummarizationSetBy = Automatic

	column race_name
