		lineageTag: b8f2e62f-79c8-4fcc-b82c-7017bdb31298
		summarizeBy: none
		sourceColumn: coords_source

		annotation SummarizationSetBy = Automatic

	partition Races = m
		mode: import
		source =
				let
				  Source = PostgreSQL.Database("localhost", "running"),
				  #"Navigation 1" = Source{[Schema = "races", Item = "v_race_results"]}[Data]
				in
				  #"Navigation 1"

	annotation PBI_ResultType = Table

