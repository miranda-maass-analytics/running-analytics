		sourceColumn: sport

		annotation SummarizationSetBy = Automatic

	column distance
		dataType: string
		lineageTag: e2d896f0-3cfc-49e5-9b92-3705c48ad134
		summarizeBy: none
		sourceColumn: distance
		sortByColumn: distance_sort

		annotation SummarizationSetBy = Automatic

