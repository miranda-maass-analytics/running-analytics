table Runs
	lineageTag: 5fbb3860-eff8-4098-bcfc-21175c6fa30f

	measure Distance = IF([Selected Unit] = "mi", SUM(Runs[distance_mi]), SUM(Runs[distance_km]))
		displayFolder: KPIs
		lineageTag: fee36804-7595-46f8-b56c-f83368d1c283

		formatStringDefinition = IF([Selected Unit] = "mi", "#,0 ""mi""", "#,0 ""km""")

	measure 'Total Runs' = COUNTROWS(Runs)
		formatString: #,0
		displayFolder: KPIs
		lineageTag: 0cc2cb51-ae0e-4409-99eb-bc5c27deab42

	measure Hours = DIVIDE(SUM(Runs[moving_time_min]), 60)
		formatString: #,0
		displayFolder: KPIs
		lineageTag: b0933da8-684e-4649-8790-9c6c50c098ed

	measure 'Longest Run' = IF([Selected Unit] = "mi", MAX(Runs[distance_mi]), MAX(Runs[distance_km]))
		displayFolder: KPIs
		lineageTag: 63ff7b88-c7e0-4e2e-86e0-a1e62b59dc3a

		formatStringDefinition = IF([Selected Unit] = "mi", "#,0.0 ""mi""", "#,0.0 ""km""")

	/// Minutes per km or per mile. Distance-weighted: total moving time / total distance
	measure Pace =
			DIVIDE(
			    SUM(Runs[moving_time_min]),
			    IF([Selected Unit] = "mi", SUM(Runs[distance_mi]), SUM(Runs[distance_km]))
			)
		formatString: 0.00
		displayFolder: Pace
		lineageTag: 09ec4269-75d8-46b2-8ef4-74a60b2fbbd6

	/// Pace as m:ss text, for cards and tooltips
	measure 'Avg Pace' =
			VAR p = [Pace]
			VAR t = ROUND(p * 60, 0)
			RETURN
			    IF(ISBLANK(p), BLANK(), INT(t / 60) & ":" & FORMAT(MOD(t, 60), "00") & " /" & [Selected Unit])
		displayFolder: Pace
		lineageTag: ed88caaf-aa52-49b7-8cda-541a2a425da2

	/// "km" or "mi" from the Units slicer; km when nothing is selected
	measure 'Selected Unit' = SELECTEDVALUE(Units[Unit], "km")
		isHidden
		displayFolder: Units
		lineageTag: 67a7d473-8c94-43a8-aeba-4a56d00d8965

	measure 'Subtitle Monthly' = [Selected Unit] & " per month"
		isHidden
		displayFolder: Units
		lineageTag: eb86a1b2-47b9-4c10-a382-592dea607ec7

	measure 'Subtitle Pace' = "min per " & [Selected Unit] & "  ·  lower is faster"
		isHidden
		displayFolder: Units
		lineageTag: 73dda344-9706-4c65-b26f-07db9159db86

	measure 'Subtitle Yearly' = [Selected Unit]
		isHidden
		displayFolder: Units
		lineageTag: 56fed7c1-0fe6-449b-83cb-ef75482665b7

