        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#f0efec"
              }
            },
            "background": {
              "solid": {
                "color": "#1a1a19"
              }
            }
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#2c2c2a"
