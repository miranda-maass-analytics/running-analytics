{
  "name": "Running Dark",
  "dataColors": [
    "#3987e5",
    "#d95926",
    "#199e70",
    "#c98500",
    "#d55181",
    "#008300",
    "#9085e9",
    "#e66767"
  ],
  "foreground": "#f0efec",
  "foregroundNeutralSecondary": "#c3c2b7",
  "foregroundNeutralTertiary": "#898781",
  "background": "#1a1a19",
  "backgroundLight": "#2c2c2a",
  "backgroundNeutral": "#383835",
  "tableAccent": "#3987e5",
  "good": "#0ca30c",
  "neutral": "#fab219",
  "bad": "#d03b3b",
  "textClasses": {
    "callout": {
      "fontSize": 30,
      "fontFace": "Segoe UI Semibold",
      "color": "#f0efec"
    },
    "title": {
      "fontSize": 13,
      "fontFace": "Segoe UI Semibold",
      "color": "#f0efec"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#f0efec"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#c3c2b7"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#1a1a19"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#2c2c2a"
              }
            },
            "radius": 12
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 16,
            "bottom": 12,
            "left": 20,
            "right": 20
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#f0efec"
              }
            },
            "fontSize": 13,
            "fontFamily": "Segoe UI Semibold",
            "alignment": "left"
