              "solid": {
                "color": "#2c2c2a"
              }
            },
            "gridlineThickness": 1
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#c3c2b7"
              }
            }
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#c3c2b7"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#0d0d0d"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#0d0d0d"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 0,
            "bottom": 0,
            "left": 0,
            "right": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "title": [
          {
            "show": false
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#f0efec"
              }
            },
            "fontSize": 30,
            "fontFamily": "Segoe UI Semibold"
          }
