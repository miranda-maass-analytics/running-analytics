        "categoryLabels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#898781"
              }
            },
            "fontSize": 11
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "title": [
          {
            "show": false
          }
        ],
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#898781"
              }
            },
            "fontFamily": "Segoe UI"
          }
