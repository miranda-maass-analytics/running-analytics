            },
            "rowPadding": 6,
            "outlineColor": {
              "solid": {
                "color": "#2c2c2a"
              }
            }
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#898781"
              }
            },
            "backColor": {
              "solid": {
                "color": "#1a1a19"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "outline": "None"
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#f0efec"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#1a1a19"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#f0efec"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#1a1a19"
              }
            },
            "outline": "None"
          }
        ]
      }
    }
  }
}