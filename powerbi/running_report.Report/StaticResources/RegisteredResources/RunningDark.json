        ],
        "subTitle": [
          {
            "fontColor": {
              "solid": {
                "color": "#898781"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#898781"
              }
            },
            "fontSize": 9,
            "showAxisTitle": false,
            "gridlineShow": false
